# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only
# publishable (anon) keys go here. Set the same values as EAS environment variables
# for cloud builds (eas env:create).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The app never talks to Propfein directly; the Edge Functions do (see supabase/functions/README.md).
