{
  "expo": {
    "name": "Last Leg",
    "slug": "lastleg",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lastleg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0B0D",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0D"
    },
    "ios": {
      "bundleIdentifier": "io.lastleg.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:lastleg.io"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#3B82F6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Last Leg uses your photo library so you can add a screenshot of your bet slip.",
          "cameraPermission": "Last Leg uses the camera so you can snap a photo of a bet slip."
        }
      ],
      "expo-status-bar",
      "expo-splash-screen",
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "iosAppGroupIdentifier": "group.io.lastleg.app",
          "iosShareExtensionBundleIdentifier": "io.lastleg.app.share-extension"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    },
    "icon": "./assets/icon.png"
  }
}
